# Database connection string. Required in production: the server refuses to
# start if it falls back to this local development default, because an unset
# variable would otherwise surface only as "connection refused" against
# localhost. Note that a platform reference that fails to resolve produces an
# empty value, which counts as unset.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/betting_tracker?sslmode=disable

# Session signing key. This is the only thing authenticating a session cookie,
# so anyone who knows it can forge one for any account including the
# administrator. The server refuses to start in production if this is left at
# its default or is shorter than 32 bytes.
# Generate with: openssl rand -hex 32
SESSION_KEY=your-32-byte-secret-key-here-change-me

# Maximum number of open PostgreSQL connections. Must leave headroom under the
# database server's own connection limit for migrations, psql sessions and any
# other client, so the right value depends on the database, not the app.
DB_MAX_OPEN_CONNS=20

# Apply pending migrations during startup (default: true). The schema and the
# binary that expects it then ship together. Turn it off only to get a server up
# against a schema left marked dirty by a failed migration, so you can go and
# look at it.
MIGRATE_ON_START=true

# Server port
PORT=8080

# Environment. Must be exactly "development" or "production" -- an unrecognised
# value is rejected at startup rather than being treated as neither, because
# production is what turns on the Secure flag for the session cookie and turns
# off SQL statement logging.
ENV=development

# IANA timezone the app resolves calendar days in ("today's games", the date
# pager) and renders timestamps in for browsers without JavaScript. Per-user
# display times are converted client side, so this is not a per-user setting.
APP_TIMEZONE=America/New_York

# College Football Data API key (get from collegefootballdata.com)
CFB_DATA_API_KEY=your-api-key-here

# College Basketball Data API key (get from collegebasketballdata.com)
CBB_DATA_API_KEY=your-cbb-api-key-here

# Basketball sync interval in minutes (default: 15)
CBB_SYNC_INTERVAL_MINS=15

# Divisions the live scoreboard sync polls, comma separated: fbs, fcs, ii, iii.
# The endpoint takes one division per call, so each entry here is another
# request every five minutes -- roughly 8,600 a month on top of the ~5,000 the
# other syncs spend. Leave unset for FBS alone, which is the only division the
# feed carries betting lines for and what the games grid filters to by default.
# CFB_SCOREBOARD_CLASSIFICATIONS=fbs,fcs

# The single site administrator. The account is created on boot if it does not
# exist and is always forced to admin. It cannot be renamed, demoted or deleted
# from the admin portal.
ADMIN_USERNAME=cfb-pbwf-admin

# Password for that account. Required on first boot. Afterwards it is only
# applied when it no longer matches the stored hash, so changing it here and
# restarting is the way back in if the password is lost.
ADMIN_PASSWORD=change-me-at-least-8-chars

# Development Dockerfile with hot reload support
FROM golang:1.27-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache git gcc musl-dev

# Copy go mod files and download deps, including the tools pinned by the
# `tool` directive in go.mod (air). Pinning via go.mod keeps the dev image
# reproducible instead of pulling an installer script at build time.
COPY go.mod go.sum ./
RUN go mod download && go install tool

# Copy source (will be overwritten by volume mount)
COPY . .

# Expose port
EXPOSE 8080

# Default command
CMD ["go", "tool", "air", "-c", ".air.toml"]

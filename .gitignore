# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Build artifacts
tmp/
dist/
build/

# `make build` output. The comment below has said "make build writes to bin/"
# since the root-level binaries were ignored, without this line to go with it.
/bin/

# Stray `go build ./cmd/x` output in the repository root. `make build` writes
# to bin/, so anything here is an accident -- and a 34 MB binary is one that
# has already had to be filtered back out of a branch once.
/server
/seed
/seedcbb
/seedtestdata
/synccalendar
/capture

# Environment variables
.env
.env.local
.env.*.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Database files
*.db
*.sqlite
*.sqlite3

# Log files
*.log

# Dependency directories
vendor/

# macOS
.DS_Store
.AppleDouble
.LSOverride

